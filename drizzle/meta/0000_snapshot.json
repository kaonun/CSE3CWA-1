      "checkConstraints": {
        "activity_title_length": {
          "name": "activity_title_length",
          "value": "length(trim(\"activity_configurations\".\"title\")) between 1 and 120"
        },
        "activity_type_settings": {
          "name": "activity_type_settings",
          "value": "(\n    \"activity_configurations\".\"type\" = 'wordle' and \"activity_configurations\".\"answer_word_id\" is not null and\n    \"activity_configurations\".\"max_guesses\" is not null and typeof(\"activity_configurations\".\"max_guesses\") = 'integer' and \"activity_configurations\".\"max_guesses\" between 3 and 8 and\n    \"activity_configurations\".\"grid_size\" is null and \"activity_configurations\".\"difficulty\" is null\n  ) or (\n    \"activity_configurations\".\"type\" = 'wordsearch' and \"activity_configurations\".\"answer_word_id\" is null and \"activity_configurations\".\"max_guesses\" is null and\n    \"activity_configurations\".\"grid_size\" is not null and typeof(\"activity_configurations\".\"grid_size\") = 'integer' and \"activity_configurations\".\"grid_size\" between 6 and 15 and\n    \"activity_configurations\".\"difficulty\" is not null and \"activity_configurations\".\"difficulty\" in ('easy', 'hard')\n  )"
        },
        "activity_hints_boolean": {
          "name": "activity_hints_boolean",
          "value": "\"activity_configurations\".\"show_hints\" in (0, 1)"
        },
        "activity_theme": {
          "name": "activity_theme",
          "value": "\"activity_configurations\".\"output_theme\" in ('light', 'dark')"
        },
        "activity_filename": {
          "name": "activity_filename",
          "value": "length(\"activity_configurations\".\"output_filename\") between 6 and 120 and \"activity_configurations\".\"output_filename\" not glob '*[^a-zA-Z0-9_.-]*' and substr(\"activity_configurations\".\"output_filename\", -5) = '.html'"
        }
      }
