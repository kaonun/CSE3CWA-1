{
  "name": "phonemele",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "predev": "npm run db:migrate",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "test:backend": "node scripts/verify-backend.mjs",
    "test:docker": "node scripts/verify-docker.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "node scripts/migrate-database.mjs",
    "test:database": "node scripts/verify-database.mjs",
    "test:client-errors": "node scripts/verify-client-errors.mjs",
    "test:ui-behavior": "node scripts/verify-ui-behavior.mjs",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "node scripts/run-playwright.mjs",
    "test:load": "node scripts/run-jmeter.mjs --stages=1",
    "test:load:staged": "node scripts/run-jmeter.mjs --stages=1,10,25,50,100",
    "test:load:full": "node scripts/run-jmeter.mjs --stages=1,10,100,1000,10000 --allow-high-load",
    "check": "npm run lint && npm run build && npm run test:client-errors && npm run test:ui-behavior && npm run test:database && npm run test:backend && npm run test:e2e:built"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6"
  }
}
